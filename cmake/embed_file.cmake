# Script mode (cmake -P): writes OUT, a .cpp holding every file in FILES ('|'-separated) as a
# byte array plus a name -> bytes lookup table in namespace pfl::NAMESPACE. Names are paths
# relative to BASE_DIR.
string(REPLACE "|" ";" files "${FILES}")

set(arrays "")
set(entries "")
set(index 0)
foreach(path IN LISTS files)
    cmake_path(RELATIVE_PATH path BASE_DIRECTORY "${BASE_DIR}" OUTPUT_VARIABLE name)
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hex_len)
    math(EXPR size "${hex_len} / 2")

    # 32 bytes (64 hex chars) per line keeps lines short for the compiler.
    set(body "")
    set(pos 0)
    while(pos LESS hex_len)
        string(SUBSTRING "${hex}" ${pos} 64 chunk)
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," chunk "${chunk}")
        string(APPEND body "    ${chunk}\n")
        math(EXPR pos "${pos} + 64")
    endwhile()

    string(APPEND arrays "// ${name}\nconst unsigned char k_data${index}[] = {\n${body}    0x00};\n\n")
    string(APPEND entries "    {\"${name}\", k_data${index}, ${size}},\n")
    math(EXPR index "${index} + 1")
endforeach()

set(content "// Generated by cmake/embed_file.cmake. Do not edit.
#include \"embedded_resources.hpp\"

namespace pfl::${NAMESPACE} {
namespace {

${arrays}struct Entry {
    std::string_view name;
    const unsigned char* data;
    std::size_t size;
};

const Entry k_entries[] = {
${entries}};

} // namespace

std::optional<std::span<const unsigned char>> find(std::string_view name) {
    for (const Entry& e : k_entries) {
        if (e.name == name) return std::span<const unsigned char>(e.data, e.size);
    }
    return std::nullopt;
}

} // namespace pfl::${NAMESPACE}
")

# Only touch the file when the content changed, to avoid needless recompiles.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
