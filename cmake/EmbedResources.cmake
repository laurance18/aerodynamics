# pfl_embed_resources(<target> BASE_DIR <dir> FILES <file>...)
#
# Creates static library <target> that compiles the listed files into the binary as byte arrays.
# Lookup at runtime by path relative to BASE_DIR, e.g. "shaders/particles.vert":
#     #include "embedded_resources.hpp"
#     auto data = pfl::embedded::find("shaders/particles.vert");
# The generated .cpp is rebuilt whenever one of the files changes.
set(_PFL_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/embed_file.cmake")

function(pfl_embed_resources target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "BASE_DIR" "FILES")
    set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}_gen")
    set(out_cpp "${gen_dir}/embedded_resources.cpp")

    file(WRITE "${gen_dir}/embedded_resources.hpp" [=[
// Generated by cmake/EmbedResources.cmake. Do not edit.
#pragma once
#include <cstddef>
#include <optional>
#include <span>
#include <string_view>

namespace pfl::embedded {

// Returns the bytes of an embedded file (not counting a trailing '\0' that is always present).
std::optional<std::span<const unsigned char>> find(std::string_view name);

inline std::optional<std::string_view> findText(std::string_view name) {
    auto bytes = find(name);
    if (!bytes) return std::nullopt;
    return std::string_view(reinterpret_cast<const char*>(bytes->data()), bytes->size());
}

} // namespace pfl::embedded
]=])

    set(abs_files "")
    foreach(f IN LISTS ARG_FILES)
        cmake_path(ABSOLUTE_PATH f BASE_DIRECTORY "${ARG_BASE_DIR}" OUTPUT_VARIABLE abs)
        list(APPEND abs_files "${abs}")
    endforeach()
    string(REPLACE ";" "|" files_arg "${abs_files}")

    add_custom_command(
        OUTPUT "${out_cpp}"
        COMMAND "${CMAKE_COMMAND}"
                "-DOUT=${out_cpp}" "-DBASE_DIR=${ARG_BASE_DIR}" "-DFILES=${files_arg}"
                -P "${_PFL_EMBED_SCRIPT}"
        DEPENDS ${abs_files} "${_PFL_EMBED_SCRIPT}"
        COMMENT "Embedding resources into ${target}"
        VERBATIM)

    add_library(${target} STATIC "${out_cpp}" "${gen_dir}/embedded_resources.hpp")
    target_include_directories(${target} PUBLIC "${gen_dir}")
    target_compile_features(${target} PUBLIC cxx_std_20)
endfunction()
