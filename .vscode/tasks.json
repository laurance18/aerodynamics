{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build",
      "type": "cmake",
      "command": "build",
      "targets": ["all"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "CMake: test",
      "type": "cmake",
      "command": "test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Package dist zip (Release)",
      "type": "shell",
      "command": "cmake --build --preset release --target dist",
      "problemMatcher": ["$msCompile"]
    }
  ]
}
